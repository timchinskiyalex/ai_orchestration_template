{
  "project": {
    "name": "replace-with-project-name",
    "documentationDir": "docs/orchestration-input",
    "generatedDir": "docs/orchestration-generated",
    "projectMode": { "schemaVersion": 1, "kind": "ProjectMode", "mode": "greenfield" },
    "repositoryBaselineDeclaration": null,
    "productRoots": [
      { "id": "frontend", "path": "frontend", "adapter": "next-node" },
      { "id": "backend", "path": "backend", "adapter": "dotnet" }
    ]
  },
  "repository": "D:/path/to/your/git/repository",
  "baseRef": "main",
  "runtimeDir": "../runtime",
  "model": "gpt-5.6-terra",
  "router": {
    "maxConcurrentTasks": 10,
    "maxChildrenPerTask": 20,
    "maxDelegationDepth": 4,
    "maxPlanTasks": 12,
    "defaultParentBudget": 250000,
    "turnTimeoutMs": 600000,
    "approvalMode": "deny"
  },
  "autonomy": {
    "mode": "autonomous",
    "autoApproveWorkflowGates": true,
    "autoRemediate": true,
    "autoPush": true,
    "autoCreatePullRequest": true,
    "autoMerge": true,
    "maxRemediationRounds": 3
  },
  "budget": {
    "weeklyTokenLimit": 500000,
    "weeklyWindowDays": 7,
    "hardRunTokenLimit": 200000,
    "interruptSafetyMarginTokens": 12000,
    "enforceLocalLimits": true
  },
  "quota": {
    "throttleAtUsedPercent": 90,
    "throttleWhenUnavailable": false
  },
  "delivery": {
    "maxRemediationRounds": 3,
    "maxWaves": 8,
    "maxNoProgressReconciliations": 2,
    "maxReconciliationDiagnostics": 25,
    "leaseHeartbeatMs": 5000,
    "staleLeaseMs": 30000,
    "shutdownGraceMs": 3000
  },
  "remote": {
    "enabled": true,
    "remoteName": "origin",
    "allowedRemotes": ["origin"],
    "candidateBranchPrefix": "swarm/candidate/",
    "requireCi": true,
    "requiredCiContexts": [],
    "ciTimeoutMs": 900000,
    "ciPollIntervalMs": 10000,
    "mergeMethod": "merge"
  },
  "roles": {
    "bootstrap": {
      "sandbox": "read-only",
      "approvalPolicy": "never",
      "tokenBudget": 24000,
      "interruptThresholdTokens": 12000,
      "usesWorktree": false
    },
    "planner": {
      "sandbox": "read-only",
      "approvalPolicy": "never",
      "tokenBudget": 16000,
      "interruptThresholdTokens": 8000,
      "usesWorktree": false
    },
    "backend": {
      "sandbox": "workspace-write",
      "approvalPolicy": "never",
      "tokenBudget": 30000,
      "interruptThresholdTokens": 18000,
      "usesWorktree": true
    },
    "frontend": {
      "sandbox": "workspace-write",
      "approvalPolicy": "never",
      "tokenBudget": 26000,
      "interruptThresholdTokens": 14000,
      "usesWorktree": true
    },
    "database": {
      "sandbox": "workspace-write",
      "approvalPolicy": "never",
      "tokenBudget": 22000,
      "interruptThresholdTokens": 12000,
      "usesWorktree": true
    },
    "qa": {
      "sandbox": "read-only",
      "approvalPolicy": "never",
      "tokenBudget": 16000,
      "interruptThresholdTokens": 8000,
      "usesWorktree": true
    },
    "security": {
      "sandbox": "read-only",
      "approvalPolicy": "never",
      "tokenBudget": 18000,
      "interruptThresholdTokens": 9000,
      "usesWorktree": true
    },
    "devops": {
      "sandbox": "workspace-write",
      "approvalPolicy": "never",
      "tokenBudget": 22000,
      "interruptThresholdTokens": 12000,
      "usesWorktree": true
    }
  }
}
